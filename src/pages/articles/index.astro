---
import type { Post } from "@types";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PostGroup from "@components/PostGroup.astro";
import { getPosts } from "@lib/posts";

const posts = await getPosts();

const groupBy = (keysOf: (post: Post) => string[]) => {
  const groups: Record<string, Post[]> = {};
  for (const post of posts) {
    for (const key of keysOf(post)) {
      (groups[key] ??= []).push(post);
    }
  }
  return groups;
};

const postsByYear = groupBy(post => [post.data.date.getFullYear().toString()]);
const years = Object.keys(postsByYear).sort((a, b) => parseInt(b) - parseInt(a));

// 가장 최근 글이 있는 태그부터
const postsByTag = groupBy(post => post.data.tags ?? []);
const tags = Object.keys(postsByTag).sort((a, b) =>
  postsByTag[b][0].data.date.valueOf() - postsByTag[a][0].data.date.valueOf()
);

const TABS = [
  { id: "posts", label: "Posts" },
  { id: "tags", label: "Tags" },
];
---

<PageLayout title="Articles" description="All articles">
  <Container>
    <div class="space-y-10">
      <div class="flex gap-4" role="tablist">
        {TABS.map(({ id, label }, index) => (
          <button
            role="tab"
            data-tab={id}
            aria-selected={index === 0 ? "true" : "false"}
            class="font-semibold text-black/40 dark:text-white/40 aria-selected:text-black dark:aria-selected:text-white"
          >
            {label}
          </button>
        ))}
      </div>

      <div data-tab-panel="posts" class="space-y-4">
        {years.map((year, index) => (
          <>
            {year === "2023" && index > 0 && (
              <div class="py-6">
                <hr class="border-black/10 dark:border-white/10" />
              </div>
            )}
            <PostGroup title={year} posts={postsByYear[year]} />
          </>
        ))}
      </div>

      <div data-tab-panel="tags" class="space-y-4 hidden">
        {tags.map(tag => (
          <PostGroup title={tag.replace(/_/g, " ")} posts={postsByTag[tag]} showDate />
        ))}
      </div>
    </div>
  </Container>
</PageLayout>

<script>
  const tabs = document.querySelectorAll<HTMLElement>("[data-tab]");
  const panels = document.querySelectorAll<HTMLElement>("[data-tab-panel]");

  tabs.forEach(tab => {
    tab.addEventListener("click", () => {
      tabs.forEach(t => t.setAttribute("aria-selected", String(t === tab)));
      panels.forEach(panel => {
        panel.classList.toggle("hidden", panel.dataset.tabPanel !== tab.dataset.tab);
      });
    });
  });
</script>
